---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.tsx';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://pintores-valencia.com/#business",
  "name": "Pintores en Valencia",
  "url": "https://pintores-valencia.com",
  "telephone": "+34722208131",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Valencia",
    "addressRegion": "Comunitat Valenciana",
    "postalCode": "46000",
    "addressCountry": "ES"
  },
  "priceRange": "€€"
};
---

<SiteLayout 
  title="Precios de Pintura en Valencia - Tarifas 2025"
  description="Consulta nuestros precios de pintura en Valencia. Tarifas competitivas para pintura interior, exterior, lacado y más. Presupuesto gratis sin compromiso."
  keywords="precios pintura valencia, tarifas pintor valencia, coste pintar casa"
  canonical="https://pintores-valencia.com/precios/"
  schema={[localBusinessSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->
    <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[{ label: "Precios" }]} client:load />
        

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center">
            <!-- Title -->
            <h1 class="text-4xl md:text-5xl font-bold mb-6">
              Precios de pintura en Valencia, sin sorpresas
            </h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
              Calcula cuánto puede costar pintar tu piso, casa o local en Valencia con precios claros y materiales incluidos.
            </p>
            
            <!-- Price highlight -->
            <div class="mb-6">
              <p class="text-lg font-semibold text-orange-600">
                Desde 12–15 €/m² <span class="text-sm text-gray-500 font-normal">(materiales incluidos)</span>
              </p>
              <p class="text-sm text-gray-500">
                Precio orientativo para viviendas en Valencia y alrededores. El precio final se confirma tras analizar las fotos y medidas proporcionadas por el cliente.
              </p>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
              <a
                href="/presupuesto/"
                class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center"
              >
                Solicitar presupuesto gratis
              </a>
              <a
                href="tel:+34722208131"
                class="h-11 px-6 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold inline-flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
           
          </div>
        </div>
      </div>
    </section>

    <!-- Tarifas por servicio -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Tarifas por servicio
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Precios orientativos con materiales incluidos y garantía de calidad
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700">
            <p class="text-lg leading-relaxed">
              Nuestras tarifas incluyen materiales de primera calidad, mano de obra profesional y limpieza final del área de trabajo.
              El precio definitivo puede variar según el estado de las superficies y la complejidad del proyecto.
            </p>
            
            <p class="text-lg leading-relaxed">
              Todos los presupuestos son cerrados y sin sorpresas. Te ofrecemos una valoración gratuita 
              en menos de 24 horas para que puedas planificar tu proyecto con total transparencia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Listado de precios -->
    <section class="py-12 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Nuestros precios
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Tarifas orientativas para todos nuestros servicios de pintura
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-4">
            <!-- Pintura Interior -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Pintura interior</h3>
                  <p class="text-gray-600 text-sm">
                    Viviendas, oficinas y espacios interiores. Incluye imprimación y dos manos de pintura plástica de calidad.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">12–15 €/m²</div>
                </div>
              </div>
            </div>

            <!-- Pintura Exterior -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Pintura exterior</h3>
                  <p class="text-gray-600 text-sm">
                    Fachadas y elementos exteriores. Incluye tratamiento y pintura específica con protección UV.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">15–20 €/m²</div>
                </div>
              </div>
            </div>

            <!-- Quitar Gotelé -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Quitar gotelé</h3>
                  <p class="text-gray-600 text-sm">
                    Lijado sin polvo, enlucido profesional e imprimación. Paredes lisas listas para pintar.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">10–12 €/m²</div>
                </div>
              </div>
            </div>

            <!-- Impermeabilización -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Impermeabilización</h3>
                  <p class="text-gray-600 text-sm">
                    Terrazas y cubiertas. Sistemas impermeables profesionales con garantía de 5 años.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">20 €/m²</div>
                </div>
              </div>
            </div>

            <!-- Lacado de Puertas -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Lacado de puertas</h3>
                  <p class="text-gray-600 text-sm">
                    Acabado profesional con lacas de alta calidad. Deja tus puertas como nuevas.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">80 €/ud</div>
                </div>
              </div>
            </div>

            <!-- Comunidades -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Pintura de comunidades</h3>
                  <p class="text-gray-600 text-sm">
                    Fachadas completas y zonas comunes. Coordinación total con la comunidad de vecinos.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-lg font-semibold text-gray-700">Presupuesto<br/>a medida</div>
                </div>
              </div>
            </div>

            <!-- Locales Comerciales -->
            <div class="bg-white border rounded-lg p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-2">Locales comerciales</h3>
                  <p class="text-gray-600 text-sm">
                    Trabajo nocturno y en fines de semana. Sin interrupciones en tu actividad comercial.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-lg font-semibold text-gray-700">Presupuesto<br/>a medida</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Otros Servicios -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Otros Servicios
            </h2>
            <p class="text-lg text-gray-600">
              Precios orientativos para trabajos especializados
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Quitar Gotelé -->
            <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-4 mb-4">
                <svg class="w-6 h-6 text-orange-600 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                </svg>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 mb-1">Quitar Gotelé</h3>
                  <p class="text-2xl font-bold text-orange-600">desde 10 €/m²</p>
                </div>
              </div>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• Lijado sin polvo</li>
                <li>• Enlucido profesional</li>
                <li>• Imprimación incluida</li>
              </ul>
              <a href="/servicios/quitar-gotele/" class="mt-4 inline-block text-orange-600 font-semibold hover:text-orange-700">
                Ver más →
              </a>
            </div>

            <!-- Pintura Exterior -->
            <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-4 mb-4">
                <svg class="w-6 h-6 text-orange-600 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                </svg>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 mb-1">Pintura Exterior</h3>
                  <p class="text-2xl font-bold text-orange-600">desde 15 €/m²</p>
                </div>
              </div>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• Fachadas y exteriores</li>
