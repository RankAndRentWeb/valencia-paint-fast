                <li>• Protección UV</li>
              </ul>
              <a href="/servicios/pintura-exterior-fachadas/" class="mt-4 inline-block text-orange-600 font-semibold hover:text-orange-700">
                Ver más →
              </a>
            </div>

            <!-- Impermeabilización -->
            <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-4 mb-4">
                <svg class="w-6 h-6 text-orange-600 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 mb-1">Impermeabilización</h3>
                  <p class="text-2xl font-bold text-orange-600">desde 20 €/m²</p>
                </div>
              </div>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• Terrazas y cubiertas</li>
                <li>• Productos profesionales</li>
                <li>• Garantía 5 años</li>
              </ul>
              <a href="/servicios/impermeabilizacion-terrazas/" class="mt-4 inline-block text-orange-600 font-semibold hover:text-orange-700">
