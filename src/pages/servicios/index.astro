---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.tsx';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://pintores-valencia.com/#business",
  "name": "Pintores en Valencia",
  "url": "https://pintores-valencia.com",
  "image": "https://pintores-valencia.com/og-home.webp",
  "telephone": "+34722208131",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Valencia",
    "addressRegion": "Comunitat Valenciana",
    "postalCode": "46000",
    "addressCountry": "ES"
  },
  "openingHours": ["Mo-Sa 08:00-20:00"],
  "priceRange": "€€",
  "areaServed": [{ "@type": "City", "name": "Valencia" }]
};

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Servicios de Pintura en Valencia",
  "itemListElement": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Quitar gotelé y alisar paredes",
        "description": "Eliminamos el gotelé de forma profesional y dejamos las paredes completamente lisas y preparadas para pintar."
      }
    },
    {
      "@type": "Offer", 
      "itemOffered": {
        "@type": "Service",
        "name": "Pintura interior de pisos y casas",
        "description": "Renovamos completamente el interior de tu hogar con pinturas de primera calidad y acabados profesionales."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service", 
        "name": "Pintura exterior y fachadas",
        "description": "Protegemos y embellecemos fachadas con pinturas resistentes a la intemperie y técnicas especializadas."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Impermeabilización de terrazas",
        "description": "Soluciones de impermeabilización para terrazas, balcones y cubiertas contra filtraciones."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Pintura locales comerciales",
        "description": "Imagen profesional en tu negocio con mínima interrupción de actividad y acabados impecables."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Pintura comunidades",
        "description": "Pintura de escaleras y zonas comunes con seguridad y planificación."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Lacado de puertas y carpintería",
        "description": "Lacado en blanco u otros colores con acabado liso y duradero."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Papel pintado y vinilos",
        "description": "Instalación profesional de papel pintado y vinilos decorativos para personalizar cualquier espacio."
      }
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta pintar un piso en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de pintar un piso en Valencia depende de metros cuadrados, estado de las paredes, tipo de pintura y si incluye quitar gotelé. Un piso de 80m² suele costar entre 1.500€ y 2.500€ con materiales incluidos. Ofrecemos presupuesto detallado gratuito en menos de 24 horas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tardáis en pintar un piso completo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un piso estándar de 70-80 m² tarda entre 4 y 6 días laborables, incluyendo preparación, imprimación, dos manos de pintura y limpieza. Si hay que quitar gotelé, se añaden 2-3 días más."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué marcas de pintura utilizáis en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabajamos con marcas premium reconocidas: Bruguer, Jotun, Sikkens, Titan y Montó. Todas ofrecen excelente cobertura, durabilidad y acabados profesionales. Para exteriores usamos pinturas con protección UV y anti-moho."
      }
    },
    {
      "@type": "Question",
      "name": "¿En qué zonas de Valencia trabajáis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabajamos en toda Valencia capital (Ruzafa, El Carmen, Benimaclet, Campanar, Patraix, Benicalap, Mestalla) y área metropolitana: Torrent, Mislata, Paterna, Burjassot, Manises, Xirivella, Aldaia, Quart de Poblet, Alaquàs y Picanya."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dais factura y garantía por escrito?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, siempre. Somos una empresa legal con todos los permisos. Emitimos factura oficial con IVA y garantía por escrito: 2 años en pintura interior, 3 años en exteriores y 5 años en impermeabilizaciones. Contamos con seguro de responsabilidad civil."
      }
    }
  ]
};
---

<SiteLayout 
  title="Servicios de Pintura en Valencia | Pintores Profesionales Certificados"
  description="Servicios profesionales de pintura en Valencia: interior, exterior, fachadas, quitar gotelé, impermeabilización. Empresa local con +10 años experiencia. Presupuesto gratis en 24h ☎️ 722 208 131"
  canonical="https://pintores-valencia.com/servicios/"
  ogImage="https://pintores-valencia.com/og-home.webp"
  schema={[localBusinessSchema, offerCatalogSchema, faqSchema]}
>
  <main class="flex-1">
    <!-- Breadcrumbs con fondo azul suave -->
    <div class="bg-blue-50/30">
      <div class="container mx-auto px-4">
        <Breadcrumbs items={[{ label: "Servicio" }]} client:load />
      </div>
    </div>
    
    <!-- Hero / Introducción con fondo azul suave -->
    <div class="bg-blue-50/30 py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold mb-8 text-center text-gray-900">
            Servicios Profesionales de Pintura en Valencia
          </h1>
          
          <div class="space-y-5 text-gray-700 leading-relaxed">
            <p class="text-lg">
              Somos una <strong>empresa de pintura profesional en Valencia</strong> con más de 10 años de experiencia transformando espacios en hogares, negocios y comunidades de toda la ciudad. Nuestro equipo de <strong>pintores profesionales certificados</strong> ofrece servicios completos de <strong>pintura interior y exterior en Valencia</strong>, adaptados a las necesidades específicas de cada cliente en Valencia capital, Ruzafa, Patraix, Campanar, Benimaclet y toda el área metropolitana.
            </p>
            
            <p class="text-lg">
              Trabajamos en pisos, casas, chalets, locales comerciales y comunidades de vecinos, siempre con el compromiso de ofrecer <strong>acabados impecables y duraderos</strong>, materiales de primera calidad y limpieza total al finalizar. Como <strong>pintores en Valencia</strong> de confianza, entendemos la importancia de cumplir plazos, mantener presupuestos cerrados sin sorpresas y ofrecer <strong>garantías por escrito</strong> en todos nuestros trabajos de pintura.
            </p>
            
            <p class="text-lg">
              Desde <a href="/servicios/quitar-gotele/" class="text-blue-600 hover:underline font-semibold" title="Quitar gotelé en Valencia">quitar gotelé y alisar paredes</a> hasta <a href="/servicios/impermeabilizacion-terrazas/" class="text-blue-600 hover:underline font-semibold" title="Impermeabilización de terrazas Valencia">impermeabilizar terrazas y cubiertas</a>, pasando por <a href="/servicios/lacado-puertas-carpinteria/" class="text-blue-600 hover:underline font-semibold" title="Lacado de puertas Valencia">lacado de puertas y carpintería</a> o <a href="/servicios/papel-pintado-vinilos/" class="text-blue-600 hover:underline font-semibold" title="Papel pintado Valencia">instalación de papel pintado y vinilos decorativos</a>, nuestros <strong>servicios de pintura en Valencia</strong> cubren todas las necesidades de renovación y revestimiento que puedas tener. Te ofrecemos <strong>presupuesto gratuito en menos de 24 horas</strong> y asesoramiento personalizado sin compromiso.
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Resto del contenido con fondo blanco -->
    <div class="container mx-auto px-4">
      <div class="py-8">

              <!-- Grid de Servicios Principales -->
              <section class="py-8">
                <h2 class="text-3xl font-bold text-center mb-4">Nuestros Servicios de Pintura en Valencia</h2>
                <p class="text-center text-gray-600 mb-8 max-w-3xl mx-auto">
                  Ofrecemos servicios completos de pintura profesional para todo tipo de proyectos en Valencia. Trabajamos con materiales de primera calidad y técnicas especializadas para garantizar resultados duraderos.
                </p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              
              <!-- 1. Pintura Interior -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/pintura-interior/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Pintura Interior</h3>
                <p class="text-gray-600 mb-4">
                  Renovamos el interior de pisos, casas y oficinas en Valencia con pinturas plásticas y esmaltes de máxima calidad. Incluimos preparación de superficies, reparación de pequeñas imperfecciones, imprimación y dos manos de acabado. Ideal para actualizar tu vivienda antes de vender o alquilar, o simplemente para darle un aire nuevo a tu hogar. Trabajamos con las mejores marcas y garantizamos resultados duraderos.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Pinturas premium lavables</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Protección de muebles y suelos</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Limpieza completa incluida</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 2. Pintura Exterior y Fachadas -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/pintura-exterior-fachadas/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Pintura Exterior y Fachadas</h3>
                <p class="text-gray-600 mb-4">
                  Protegemos y embellecemos fachadas de edificios, chalets y locales comerciales con pinturas especiales anti-moho y resistentes a los cambios climáticos de Valencia. Incluimos limpieza a presión, reparación de grietas, imprimación selladora y aplicación de revestimientos elásticos de larga duración. Montaje de andamios certificados y seguro de responsabilidad civil en todos los trabajos exteriores.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Pinturas impermeables y transpirables</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Andamiaje certificado incluido</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Seguro RC vigente</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 3. Quitar Gotelé -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/quitar-gotele/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Quitar Gotelé y Alisar Paredes</h3>
                <p class="text-gray-600 mb-4">
                  Eliminamos el gotelé de techos y paredes mediante lijado sin polvo y técnicas de enlucido profesional para dejar superficies completamente lisas. Perfecto para modernizar pisos antiguos en Valencia, aumentar el valor de tu vivienda o simplemente disfrutar de paredes lisas y elegantes. Incluye imprimación y acabado listo para pintar o decorar según prefieras.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Sistema sin polvo con aspiración</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Enlucido y alisado perfecto</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Resultado liso duradero</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 4. Impermeabilización de Terrazas -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/impermeabilizacion-terrazas/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Impermeabilización de Terrazas</h3>
                <p class="text-gray-600 mb-4">
                  Solucionamos problemas de filtraciones y humedades en terrazas, balcones y cubiertas planas con sistemas de impermeabilización profesionales. Aplicamos membranas líquidas o láminas asfálticas de alta calidad, sellado de juntas y desagües, y acabados transitables resistentes a rayos UV. Garantía de 5 años contra filtraciones en todos nuestros trabajos de impermeabilización.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Sistemas certificados y testados</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Sellado de juntas y desagües</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Garantía 5 años</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 5. Lacado de Puertas -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/lacado-puertas-carpinteria/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Lacado de Puertas y Carpintería</h3>
                <p class="text-gray-600 mb-4">
                  Renovamos puertas de madera, armarios y carpintería interior con lacados en blanco satinado, mate o brillo, así como en cualquier color RAL que desees. Proceso completo de lijado, imprimación, aplicación a pistola y secado controlado para evitar motas y goteos. Perfecto para actualizar pisos antiguos sin cambiar las puertas, ahorrando tiempo y dinero con resultados como recién estrenadas.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Aplicación a pistola profesional</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Acabado liso sin marcas</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Secado rápido y controlado</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 6. Papel Pintado y Vinilos -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/papel-pintado-vinilos/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Papel Pintado y Vinilos Decorativos</h3>
                <p class="text-gray-600 mb-4">
                  Instalación profesional de papel pintado, vinilos decorativos y murales personalizados para paredes de salones, dormitorios, oficinas y locales comerciales. Trabajamos con papeles importados de alta calidad, vinilos lavables y tejidos texturizados. Incluye preparación de paredes, corte preciso, encolado sin burbujas y alineado perfecto de dibujos. Ideal para crear ambientes únicos y modernos en tu hogar.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Alineado perfecto de estampados</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Aplicación sin burbujas</span>
