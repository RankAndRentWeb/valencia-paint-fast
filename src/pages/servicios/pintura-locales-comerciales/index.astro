const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Pueden trabajar por las noches o fines de semana?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, trabajamos noches, madrugadas, fines de semana y festivos sin recargo adicional para no interrumpir la actividad del negocio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipos de negocios atienden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Restaurantes, oficinas, tiendas, clínicas, peluquerías, talleres, naves, centros comerciales y cualquier tipo de local comercial."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda un local comercial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un local pequeño 1-2 noches. Un local grande 3-5 noches. Planificamos para minimizar el cierre del negocio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Utilizan pinturas especiales?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, pinturas lavables, antibacterianas y de secado rápido según el negocio. Para restaurantes resistentes a grasas, para clínicas antibacterianas."
      }
    }
  ]
};
---

<SiteLayout 
  title="Pintura de locales comerciales en Valencia desde 10€/m²"
  description="Pintamos tu local comercial sin interrumpir tu negocio. Trabajamos noches y fines de semana. Secado rápido. Presupuesto gratis en 24h."
  keywords="pintura locales comerciales valencia, pintar negocio valencia, pintura oficinas valencia, pintura restaurantes valencia, precio pintar local valencia"
  canonical="https://pintores-valencia.com/servicios/pintura-locales-comerciales/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->
    <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
      <div class="container mx-auto px-4">
        <Breadcrumbs items={[
            { label: "Servicios", href: "/servicios/" },
            { label: "Locales Comerciales" }
          ]} client:load />
      </div>

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <!-- Left side - Content -->
            <div>
              <!-- Title -->
              <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Pintura de locales comerciales en Valencia</h1>
              
              <!-- Subtitle -->
              <p class="text-xl text-gray-700 mb-6">Pintamos tu negocio sin interrumpir la actividad comercial. Trabajamos noches y fines de semana</p>
              
              <!-- Price -->
              <div class="mb-6">
                <span class="text-2xl font-bold text-accent">desde 10€/m² <span class="text-sm text-gray-500 font-normal">Material incluido</span></span>
              </div>
              
              <!-- CTAs -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                  Presupuesto Gratis
                </a>
                <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold inline-flex items-center justify-center gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                  </svg>
                  722 208 131
                </a>
              </div>
              
              <!-- Features -->
              <div class="space-y-2">
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Trabajo nocturno</span>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Sin interrupciones</span>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Secado rápido</span>
                </div>
              </div>
            </div>
            
            <!-- Right side - Image -->
            <div class="order-first lg:order-last">
              <div class="relative rounded-2xl overflow-hidden shadow-xl">
                <img src={localComercialImg.src} alt="Pintura de locales comerciales en Valencia - Pintores profesionales trabajando en un negocio" width={localComercialImg.width} height={localComercialImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio y Condiciones -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Pintar Locales Comerciales en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente desde 10€/m² con materiales incluidos
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700">
            <p class="text-lg leading-relaxed">
              El <strong>precio de pintar un local comercial en Valencia</strong> depende del tipo de negocio, la superficie total, el tipo de pintura requerida y la complejidad del trabajo. En todos los casos ofrecemos un <strong>presupuesto cerrado, detallado y transparente</strong>, sin sorpresas.
            </p>
            
            <p class="text-lg leading-relaxed">
              <strong>Sin recargos por trabajo nocturno o fines de semana.</strong> Trabajamos cuando tu negocio está cerrado para no interrumpir la actividad comercial. Utilizamos <strong>pinturas específicas según el tipo de negocio</strong>:
            </p>

            <ul class="space-y-3 ml-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Clínicas y consultas médicas:</strong> pinturas lavables y antibacterianas</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Restaurantes y bares:</strong> pinturas resistentes a grasas y humedad</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Tiendas y comercios:</strong> pinturas de secado rápido y alta durabilidad</span>
              </li>
            </ul>

            <p class="text-lg leading-relaxed">
              El precio siempre incluye <strong>preparación completa de superficies, imprimación profesional y acabado de alta calidad</strong>. No tendrás que preocuparte por nada más.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso Paso a Paso -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-blue-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Nuestro Proceso Paso a Paso
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Así trabajamos para pintar tu local sin interrumpir tu negocio
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <!-- Paso 1 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  1
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Visita y Planificación</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Visitamos tu local para evaluar el trabajo necesario y <strong>planificar según los horarios de tu negocio</strong>. Coordinamos el trabajo para que puedas seguir operando con normalidad.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  2
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Protección del Mobiliario</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Realizamos <strong>protección completa de muebles, equipos, productos y zonas sensibles</strong>. Cubrimos todo con lonas profesionales y cinta de carrocero para evitar cualquier daño o mancha.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  3
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Preparación de Superficies</h3>
                  <p class="text-gray-700 leading-relaxed">
                    <strong>Limpieza profunda, lijado y reparación</strong> de grietas o imperfecciones. Este paso es fundamental para garantizar un acabado profesional y duradero que resista el uso intensivo del local comercial.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  4
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Aplicación de Pintura Específica</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Uso de <strong>pinturas técnicas según el tipo de negocio</strong>: antibacterianas para clínicas, lavables y resistentes para restaurantes, o de secado rápido para comercios. Aplicamos imprimación y dos capas de acabado.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 5 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  5
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Acabado y Retoques</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Aplicación de <strong>acabados finales y revisión completa</strong> del trabajo realizado. Nos aseguramos de que cada detalle esté perfecto antes de retirar las protecciones.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 6 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  6
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Limpieza y Entrega</h3>
                  <p class="text-gray-700 leading-relaxed">
                    <strong>Limpieza total del local</strong> y retirada de todas las protecciones. Tu negocio quedará completamente listo para abrir al día siguiente, sin olores fuertes ni residuos.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Contact Section -->
    <section class="py-12 bg-blue-600 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">¿Necesitas pintar tu local?</h2>
        <p class="text-xl mb-8">Te respondemos en menos de 24 horas</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-orange-500 text-white hover:bg-orange-600 focus:ring-orange-500 shadow-md hover:shadow-lg px-6 py-3 text-lg rounded-lg">
            Pedir presupuesto gratis
          </a>
          <a href="tel:+34722208131" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-white text-blue-600 hover:bg-gray-100 focus:ring-blue-500 shadow-md hover:shadow-lg px-6 py-3 text-lg rounded-lg gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
            </svg>
            722 208 131
          </a>
        </div>
      </div>
    </section>
    
    <!-- FAQ -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-blue-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Preguntas Frecuentes sobre Pintura de Locales Comerciales
          </h2>
          <p class="text-lg text-gray-600">
            Resolvemos todas tus dudas sobre nuestro servicio profesional
          </p>
        </div>

        <div class="max-w-4xl mx-auto space-y-6">
          <!-- FAQ 1 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Pueden trabajar por las noches o fines de semana?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              <strong>Sí, sin recargo adicional.</strong> Nos especializamos en trabajos fuera del horario comercial para no interrumpir la actividad del negocio. Trabajamos noches, madrugadas, fines de semana y festivos cuando tu local está cerrado.
            </p>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Qué tipos de negocios atienden?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              Atendemos <strong>todo tipo de locales comerciales</strong>: restaurantes, oficinas, tiendas, clínicas, peluquerías, centros de estética, talleres, naves industriales, consultas médicas, gimnasios, centros comerciales y cualquier espacio comercial que necesite renovación.
            </p>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
