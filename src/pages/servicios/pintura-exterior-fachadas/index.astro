                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Zonas Específicas</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Balcón o terraza</span>
                    <span class="font-bold text-accent">desde 200€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Patio interior</span>
                    <span class="font-bold text-accent">desde 350€</span>
                  </li>
                  <li class="flex justify-between items-center">
