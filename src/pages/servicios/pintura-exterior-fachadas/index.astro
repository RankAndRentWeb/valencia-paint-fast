const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta pintar una fachada exterior en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de pintar una fachada en Valencia parte desde 15€/m² con materiales incluidos. El coste final depende del estado de la superficie, altura del edificio, tipo de pintura y metros cuadrados. Incluimos imprimación, dos manos de pintura exterior resistente a la intemperie con protección UV, y limpieza completa. Ofrecemos presupuesto cerrado sin sorpresas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué pinturas utilizáis para pintar fachadas en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilizamos pinturas de primera calidad específicas para exterior de marcas profesionales como Bruguer, Titan y Montó. Todas nuestras pinturas para fachadas incluyen protección UV, resistencia a la intemperie, anti-moho y propiedades impermeabilizantes. Trabajamos con pinturas plásticas, acrílicas y revestimientos texturizados según las necesidades de cada fachada."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo se tarda en pintar una fachada completa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El tiempo para pintar una fachada en Valencia varía según el tamaño y estado. Una fachada de 100m² tarda entre 5-8 días laborables. Incluye: inspección y protección (1 día), limpieza y reparaciones (1-2 días), imprimación (1 día), primera mano (1-2 días), segunda mano y acabado (1-2 días). Siempre consideramos las condiciones meteorológicas para garantizar calidad óptima."
      }
    }
  ]
};
---

<SiteLayout 
  title="Pintura Exterior de Fachadas en Valencia | Desde 15€/m² +Garantía"
  description="Expertos en pintura exterior y fachadas en Valencia. Pinturas resistentes a la intemperie, protección UV y garantía 5 años. Presupuesto gratis en 24h. Desde 15€/m²."
  keywords="pintura exterior valencia, pintar fachada valencia, pintores exteriores valencia, pintura fachadas valencia, pintar fachadas valencia, pintura exterior profesional valencia"
  canonical="https://pintores-valencia.com/servicios/pintura-exterior-fachadas/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Pintura Exterior" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Pintura Exterior de Fachadas en Valencia</h1>
            
            <!-- Subtitle -->
