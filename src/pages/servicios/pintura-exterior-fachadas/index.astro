              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={fachadaExteriorImg.src} alt="Pintura exterior de fachadas en Valencia - Pintores profesionales trabajando en fachada" width={fachadaExteriorImg.width} height={fachadaExteriorImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio pintura exterior Valencia -->
    <section class="py-16 bg-white">
