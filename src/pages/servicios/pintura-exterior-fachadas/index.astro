                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fachada 200 m²</span>
                    <span class="font-bold text-accent">desde 2.800€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye imprimación y dos manos</p>
              </div>

              <!-- Precio por zonas -->
