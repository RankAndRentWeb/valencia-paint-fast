const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta impermeabilizar una terraza en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de impermeabilización en Valencia parte desde 18€/m² con materiales incluidos. El coste final depende del tipo de superficie (terraza, fachada, cubierta), el estado actual y los metros cuadrados. Incluimos reparación de grietas, imprimación, aplicación del impermeabilizante y limpieza completa. Ofrecemos presupuesto cerrado sin sorpresas y garantía de 10 años."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipo de impermeabilizante utilizáis en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilizamos impermeabilizantes profesionales específicos para cada superficie: poliuretano de alta resistencia para terrazas transitables, acrílicos elásticos para fachadas expuestas, y membranas líquidas transpirables para cubiertas. Todos nuestros productos tienen certificación de calidad y máxima durabilidad contra filtraciones de agua."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo se tarda en impermeabilizar una terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El tiempo para impermeabilizar una terraza en Valencia varía según el tamaño y estado. Una terraza de 20-30 m² tarda entre 2 y 4 días laborables. Incluye: inspección y diagnóstico (medio día), limpieza y reparación de grietas (1 día), imprimación (medio día), aplicación del impermeabilizante en capas (1-2 días). Siempre consideramos las condiciones meteorológicas para garantizar calidad óptima."
      }
    }
  ]
};
