const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué incluye el servicio de pintura de comunidades?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye rehabilitación de fachadas, pintura de escaleras, portales, sótanos, garajes y todas las zonas comunes, con preparación completa de superficies, reparaciones menores, imprimación y acabado profesional."
      }
    },
    {
      "@type": "Question",
      "name": "¿Necesito licencia de obra para pintar la fachada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Normalmente no se necesita licencia de obra mayor para trabajos de mantenimiento y pintura de fachadas. Te asesoramos sobre la documentación necesaria según la normativa municipal de Valencia."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo se organiza el trabajo en una comunidad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coordinamos directamente con el administrador de fincas y la junta de propietarios. Planificamos los trabajos por fases para minimizar molestias y mantenemos comunicación constante sobre el progreso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué garantía ofrecen en trabajos de comunidades?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofrecemos 3 años de garantía en fachadas y 2 años en zonas interiores. La garantía cubre defectos de aplicación y problemas relacionados con la calidad de los materiales utilizados."
      }
    }
  ]
};
---

<SiteLayout 
  title="Pintura de comunidades en Valencia desde 8€/m² | Fachadas"
  description="Especialistas en pintura de comunidades en Valencia. Fachadas, escaleras y zonas comunes. Trabajamos con administradores de fincas. Presupuesto en 24h."
  keywords="pintura comunidades valencia, pintar fachada comunidad valencia, pintura edificios valencia, pintar zonas comunes valencia, precio pintar comunidad valencia"
  canonical="https://pintores-valencia.com/servicios/pintura-comunidades/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Pintura Comunidades" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Pintura de comunidades en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Especialistas en rehabilitación de fachadas, escaleras y zonas comunes. Trabajamos con administradores de fincas</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 8€/m² <span class="text-sm text-gray-500 font-normal">Material incluido</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Con administradores de fincas</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Sin licencias complejas</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Garantía 3 años</span>
              </div>
            </div>
          </div>
          
          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={fachadaExteriorImg.src} alt="Pintores de comunidades trabajando en la rehabilitación de una fachada en el centro de Valencia - Servicio profesional con garantía" width={fachadaExteriorImg.width} height={fachadaExteriorImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio Pintura Comunidades Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Pintar Comunidades en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente desde 8€/m² con materiales incluidos
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de pintar comunidades en Valencia</strong> depende del tipo de superficie a pintar, la altura del edificio, el estado de conservación y los metros cuadrados totales. En todos los casos ofrecemos un presupuesto cerrado, detallado y transparente, sin sorpresas.
            </p>
            
            <p class="text-lg leading-relaxed">
              Trabajamos directamente con <strong>administradores de fincas y juntas de propietarios</strong> para facilitar todo el proceso. Utilizamos pinturas específicas según la zona: <strong>resistentes a la intemperie para fachadas</strong>, lavables para escaleras, y pinturas técnicas especiales para garajes. Incluimos preparación de superficies, reparaciones menores, imprimación y acabado profesional con <strong>garantía de 3 años en fachadas</strong>.
            </p>
            
            <p class="text-lg leading-relaxed">
              Damos <strong>servicio técnico en todos los distritos de Valencia</strong>, desde fincas señoriales en <strong>L'Eixample y Ciutat Vella</strong> hasta edificios modernos en <strong>Campanar o la Avenida de Francia</strong>. Nuestra logística nos permite ofrecer <strong>presupuestos rápidos en menos de 24h</strong> en toda el área metropolitana, incluyendo <strong>Torrent y Paterna</strong>.
            </p>
          </div>

          <!-- Tabla de precios orientativos -->
          <div class="bg-gradient-to-br from-blue-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Pintura de Comunidades en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por zona -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Tipo de Zona</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fachada completa</span>
                    <span class="font-bold text-accent">desde 8€/m²</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Escaleras y portales</span>
                    <span class="font-bold text-accent">desde 12€/m²</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Garajes y sótanos</span>
                    <span class="font-bold text-accent">desde 6€/m²</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye preparación y materiales</p>
              </div>

              <!-- Precio por edificio -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Proyecto Completo</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Edificio 4 plantas</span>
                    <span class="font-bold text-accent">desde 3.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Edificio 6 plantas</span>
                    <span class="font-bold text-accent">desde 5.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Zonas comunes completas</span>
                    <span class="font-bold text-accent">desde 1.800€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según altura</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye el Precio de Pintar Comunidades?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Coordinación con administrador</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Andamios y protecciones</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Reparación de grietas</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Imprimación profesional</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Pinturas de alta calidad</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Limpieza completa final</span>
                </div>
              </div>
            </div>

          <div class="mt-8 bg-white rounded-xl p-6">
            <p class="text-lg text-gray-700 mb-6">
              <strong>¿Necesitas renovar tu comunidad?</strong> Consulta nuestro <strong>precio de pintar comunidades en Valencia</strong> y descubre cómo podemos mejorar tu edificio con nuestro servicio profesional especializado en trabajos comunitarios.
            </p>
            <div class="flex justify-center text-center">
