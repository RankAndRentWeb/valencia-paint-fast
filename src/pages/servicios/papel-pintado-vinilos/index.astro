                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fibra de vidrio</span>
                    <span class="font-bold text-accent">desde 35€/m²</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye preparación e instalación</p>
              </div>

              <!-- Precio por zona -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Espacios</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Habitación individual</span>
                    <span class="font-bold text-accent">desde 400€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Salón-comedor</span>
