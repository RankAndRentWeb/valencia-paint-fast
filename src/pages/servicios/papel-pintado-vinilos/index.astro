            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Instalación de Papel Pintado en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por tipo de papel -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Tipo de Material</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Papel pintado estándar</span>
                    <span class="font-bold text-accent">desde 25€/m²</span>
