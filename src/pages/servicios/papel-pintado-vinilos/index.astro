const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué tipos de papel pintado instaláis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Instalamos todo tipo de papel pintado: papel tradicional, vinilos decorativos, fibra de vidrio y papeles especiales. Trabajamos con todas las marcas y diseños del mercado. Te asesoramos para elegir el material más adecuado según el espacio y tus necesidades."
      }
    },
    {
      "@type": "Question",
      "name": "¿Incluís la preparación de las paredes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, la preparación está incluida en el precio. Lijamos, reparamos imperfecciones y aplicamos imprimación específica para papel pintado. Una correcta preparación es esencial para conseguir un acabado perfecto y duradero."
      }
    },
    {
      "@type": "Question",
      "name": "¿Retiráis el papel antiguo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, retiramos el papel pintado antiguo con técnicas profesionales que no dañan la pared. Después preparamos la superficie completamente para la nueva instalación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda la instalación?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La instalación de papel pintado en una habitación estándar suele tardar 1-2 días. Para viviendas completas, entre 3 y 5 días dependiendo de los metros cuadrados y la complejidad del patrón. Te daremos un plazo exacto con el presupuesto."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo aportar yo el papel o vinilo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Por supuesto. Podemos instalar el papel pintado que tú elijas o asesorarte en la compra. Si lo prefieres, nos encargamos de todo: elección, compra e instalación profesional del papel más adecuado para tu proyecto."
      }
    }
  ]
};
---

<SiteLayout 
  title="Empapelado en Valencia – Papel pintado y vinilos"
  description="Instalación profesional de papel pintado y vinilos decorativos en Valencia. Preparación de paredes incluida, asesoramiento en diseños y presupuesto gratis."
  keywords="papel pintado valencia, vinilos decorativos valencia, empapelar valencia"
  canonical="https://pintores-valencia.com/servicios/papel-pintado-vinilos/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Papel Pintado" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Papel pintado y vinilos decorativos en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Transformamos tus espacios con papel pintado y vinilos de diseño con instalación profesional</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 25€/m² <span class="text-sm text-gray-500 font-normal">Instalación incluida</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/presupuesto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Instalación perfecta</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
