                </svg>
                <span class="text-gray-700">Asesoramiento gratis</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={pinturaInteriorImg.src} alt="Papel pintado y vinilos decorativos Valencia - Instalación profesional" width={pinturaInteriorImg.width} height={pinturaInteriorImg.height} class="w-full h-auto object-cover" loading="lazy">
            </div>
