const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Lacáis las puertas en casa o las llevamos a taller en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabajamos tanto in situ en tu hogar como en nuestro taller profesional en Valencia. Para acabados premium y lacados de alta calidad, recomendamos el lacado en taller donde controlamos mejor las condiciones de temperatura, humedad y polvo. Sin embargo, también podemos lacar puertas en casa si tu situación lo requiere, protegiendo adecuadamente las zonas de trabajo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipos de lacado de puertas ofrecéis en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofrecemos lacado mate (moderno y elegante), lacado satinado (resistente y fácil de limpiar) y lacado brillo (efecto espejo) en cualquier color de la carta RAL. También realizamos lacado efecto madera, acabados metalizados, pátinas especiales y efectos decorativos personalizados. Utilizamos lacas profesionales de máxima calidad con certificación ecológica."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda el proceso de lacado de puertas en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "En taller: 3-5 días laborables incluyendo desmontaje, preparación, lacado, secado y montaje final. En casa: 2-3 días dependiendo del número de puertas, tipo de acabado y condiciones ambientales. Los tiempos pueden variar según el estado inicial de las puertas y el tipo de lacado elegido. Te informamos con exactitud en el presupuesto."
      }
    },
    {
      "@type": "Question",
      "name": "¿El precio del lacado de puertas incluye desmontaje y montaje en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, nuestro servicio completo de lacado de puertas en Valencia incluye: desmontaje cuidadoso de puertas y herrajes, transporte al taller (si aplica), preparación y lijado completo, aplicación profesional de laca, secado en condiciones controladas, montaje final con ajustes de bisagras y verificación del cierre perfecto. Solo pagas por el resultado final sin cargos ocultos."
      }
    }
  ]
};
