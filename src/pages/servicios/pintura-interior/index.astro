                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye preparación, imprimación y 2 manos</p>
              </div>

              <!-- Precio por habitación -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
