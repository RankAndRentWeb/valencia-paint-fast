const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta pintar las paredes de una vivienda en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de pintura interior en Valencia parte desde 8€/m² con materiales incluidos. Un piso de 70 m² cuesta desde 560€ y uno de 90 m² desde 720€. El precio final depende del estado de las paredes y tipo de pintura. Solicita presupuesto gratuito sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo se tarda en pintar el interior de una casa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para pintar el interior de una vivienda en Valencia de 70-90 m², el proceso completo tarda entre 3 y 5 días laborables. Esto incluye preparación de superficies, imprimación, dos manos de pintura y limpieza final. El tiempo exacto depende del estado de las paredes."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye el precio de pintura interior?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de pintura interior en Valencia incluye todos los materiales profesionales (pinturas de calidad, imprimación, masilla), mano de obra especializada, preparación de superficies, protección de suelos y muebles, y limpieza completa final. Presupuesto gratuito sin costes ocultos."
      }
    }
  ]
};
---

<SiteLayout 
  title="Pintura Exterior en Valencia | Fachadas Resistentes Desde 15€/m²"
  description="Expertos en pintura interior de viviendas en Valencia. Precios competitivos desde 8€/m². Acabados de alta calidad para techos y paredes. Presupuesto gratuito."
  keywords="pintura interior valencia, pintar paredes valencia, pintura casas valencia, precios pintura interior valencia, pintura techos valencia, pintores profesionales valencia"
  canonical="https://pintores-valencia.com/servicios/pintura-interior/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->
      <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Pintura Interior" }
            ]}  client:load />
      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
