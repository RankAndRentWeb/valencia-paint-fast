---
// Los “blogs” están dentro de /src/content porque Astro usa Content Collections.
// Esto permite: validación de frontmatter (schemas), carga tipada con getCollection(),
// generación de rutas estáticas y filtrado fácil por slug.
// getCollection('blogs') obtiene todos los documentos de la colección “blogs”,
// y luego filtramos por slug que empieza con la categoría (cat.slug + "/").
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const cats = await getCollection('blogCategories');
  return cats.map(c => ({ 
    params: { category: c.data.slug }, 
    props: { cat: c.data } 
  }));
}

const { cat } = Astro.props;
const posts = (await getCollection('blogs')).filter(p => p.slug.startsWith(cat.slug + "/"));

// Imagen genérica por categoría (fallback)
const fallbackImages: Record<string, string> = {
  'gotele': '/_blog/gotele-grueso-primer-plano-textura-pared.jpg',
  'impermeabilizacion': '/_blog/quitar-gotele-en-casa-proceso.jpg',
  'colores-interior': '/_blog/elegir-colores-hogar.jpg',
  'fachadas-exterior': '/_blog/salon-antiguo-anos-70-con-gotele-en-paredes.jpg',
  'barnices-madera': '/_blog/aplicacion-masilla-alisar-paredes.jpg'
};
const defaultImage = fallbackImages[cat.slug] || '/_blog/gotele-grueso-primer-plano-textura-pared.jpg';
---

<SiteLayout title={`${cat.name} - Blog de Pintura Valencia`} description={cat.description}>
  <div class="container mx-auto px-4">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: cat.name }]} client:load />

    <div class="py-12">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">{cat.name}</h1>
        {cat.description && (
          <p class="text-xl text-muted-foreground max-w-2xl mx-auto">{cat.description}</p>
        )}
      </div>
    </div>
  </div>

  <section class="container mx-auto px-4 pb-12">
    <div class="grid md:grid-cols-2 gap-6">
      {posts.map(p => {
        const [, slug] = p.slug.split("/");
        const postImage = p.data.cover || defaultImage;
        return (
          <a href={`/blog/${cat.slug}/${slug}/`} class="rounded-xl border hover:shadow transition block overflow-hidden group">
            <div class="flex flex-col sm:flex-row gap-4 p-6">
              {/* Imagen del post */}
              <div class="flex-shrink-0 mx-auto sm:mx-0">
                <img 
                  src={postImage} 
                  alt={p.data.title}
                  loading="lazy"
                  class="w-16 h-16 object-cover rounded-lg group-hover:scale-105 transition-transform duration-200"
                />
              </div>
              
              {/* Contenido de texto */}
              <div class="flex-1 text-center sm:text-left">
                <h2 class="text-lg font-semibold mb-2 group-hover:text-primary transition-colors">{p.data.title}</h2>
                <p class="text-gray-600 text-sm leading-relaxed">{p.data.excerpt}</p>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</SiteLayout>
